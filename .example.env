DEBUG=true
SECRET_KEY=django-insecure-change-me-for-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (backend served at https://api-mafia.alward.dev):
# DEBUG=false
# SECRET_KEY=your-long-random-secret-key
# ALLOWED_HOSTS=api-mafia.alward.dev
# CSRF — full origins, comma-separated. Defaults to the https entries of
# CORS_ALLOWED_ORIGINS when left empty.
# CSRF_TRUSTED_ORIGINS=https://api-mafia.alward.dev,https://mafia.alward.dev,https://mf.alward.dev
# Set to true only if Django itself should force HTTPS redirects
# (normally TLS is terminated at nginx, so leave false).
# SECURE_SSL_REDIRECT=false
DB_NAME=mafia
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
# Set in production if Redis requires auth:
# REDIS_PASSWORD=your-redis-password
# DB index for game state + Django cache (0=Celery, 1=Channels layer).
REDIS_DB=2
# Full URL override (e.g. managed Redis). Wins over host/port above;
# the DB index is still swapped per-use (0/1/REDIS_DB).
# REDIS_URL=redis://:your-redis-password@redis:6379/2
# Explicit Celery URLs (default: derived from Redis host as db 0):
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# CORS — comma-separated frontend origins allowed to make cross-site requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
# Production (frontends served at https://mafia.alward.dev, https://mf.alward.dev):
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,https://api-mafia.alward.dev,https://mf.alward.dev,https://mafia.alward.dev
# Email (Django-Anymail + Resend)
# Get a key at https://resend.com/api-keys; verify your sending domain there.
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# When true (default), registering generates an OTP code and emails it.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TIMEOUT_MINUTES=10
# Public frontend URL used to build links in emails (password reset, ...).
# Production (frontend served at https://mafia.alward.dev):
# FRONTEND_URL=https://mafia.alward.dev
FRONTEND_URL=http://localhost:5173
# Optional override (defaults to the Anymail Resend backend):
# DJANGO_EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# LiveKit (WebRTC media server)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_SERVER_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_APP_ID=your-app-id
