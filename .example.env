DB_NAME=mafia
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
ALLOWED_HOSTS=localhost,127.0.0.1
# Email (Django-Anymail + Resend)
# Get a key at https://resend.com/api-keys; verify your sending domain there.
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# When true (default), registering generates an OTP code and emails it.
EMAIL_VERIFICATION_ENABLED=true
# Public frontend URL used to build links in emails (password reset, ...).
# Production: https://mf.alward.dev
FRONTEND_URL=http://localhost:5173
# Optional override (defaults to the Anymail Resend backend):
# DJANGO_EMAIL_BACKEND=anymail.backends.resend.EmailBackend
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_APP_ID=your-app-id
